# Copy to deploy/.env
JWT_SECRET=                      # openssl rand -hex 32
APP_PUBLIC_URL=http://localhost  # URL users open (used for CORS + invitation links)
EDGE_PORT=80

# Optional AI model for the Docker analyzer / deployment insights
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional: report to TaskFlow so the AI can predict risk and gate the cutover
# (create a deployment in the TaskFlow UI → "Pipeline integration" shows these values)
TASKFLOW_API=
TASKFLOW_DEPLOYMENT_ID=
TASKFLOW_INGEST_TOKEN=

# Tuning
SOAK_BATCHES=6                   # number of health-sample batches before the gate
PROBES_PER_BATCH=5               # health requests per batch (1 per PROBE_INTERVAL)
PROBE_INTERVAL=1
POST_SWITCH_BATCHES=3            # batches of monitoring after traffic is switched
AUTO_ROLLBACK=1                  # roll back automatically if post-switch health fails
